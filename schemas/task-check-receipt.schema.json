{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamwise.dev/schemas/task-check-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check", "checked_at", "lineage_sha256", "specs", "authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "check": {"enum": ["validate", "preflight"]},
    "checked_at": {"type": "string", "format": "date-time"},
    "lineage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "specs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "authorization": {"const": false}
  }
}
