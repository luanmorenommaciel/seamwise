{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamwise.dev/schemas/recipe-v1.json",
  "title": "Seamwise authored compilation recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "system_map", "evidence", "seams", "steel_thread"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "claim": {"enum": ["current", "proposed", "derived", "external"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "captured_at", "sha256"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "anyOf": [
            {"format": "uri", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"},
            {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\s)(?!.*//)[^/]+(?:/[^/]+)*$"}
          ]
        },
        "captured_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "source", "confidence", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "claim": {"$ref": "#/$defs/claim"},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then"],
      "properties": {
        "id": {"enum": ["B-1", "B-2"]},
        "given": {"type": "string", "minLength": 1},
        "when": {"type": "string", "minLength": 1},
        "then": {"type": "string", "minLength": 1}
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "bash", "verifies"],
      "properties": {
        "id": {"enum": ["eval_1", "eval_2", "eval_3"]},
        "description": {"type": "string", "minLength": 1},
        "bash": {"type": "string", "minLength": 1},
        "verifies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["B-1", "B-2"]}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "done_condition", "effort", "profile", "execution_backend", "required_tools", "depends_on", "touches_paths", "creates_paths", "behavior", "evals", "anti_patterns", "do_not_touch"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "done_condition": {"type": "string", "minLength": 1},
        "effort": {"enum": ["XS", "S", "M", "L"]},
        "profile": {"enum": ["lite", "standard", "full"]},
        "execution_backend": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
        "required_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9._+-]+$"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T-"}},
        "touches_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "creates_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "behavior": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/behavior"}},
        "evals": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/eval"}},
        "anti_patterns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "reason", "instead"],
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "instead": {"type": "string", "minLength": 1}
            }
          }
        },
        "do_not_touch": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 1},
        "observability": {"type": "string", "minLength": 1}
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observable_state", "proof", "requires", "produces", "tasks"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "observable_state": {"type": "string", "minLength": 1},
        "proof": {"type": "string", "minLength": 1},
        "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "swimlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "legs"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "legs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leg"}}
      }
    },
    "seam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "evidence", "responsibility", "consumes", "produces", "owner", "independent_proof", "rejected_alternatives", "swimlane"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "responsibility": {"type": "string", "minLength": 1},
        "consumes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "owner": {"type": "string", "minLength": 1},
        "independent_proof": {"type": "string", "minLength": 1},
        "decision_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alternative", "reason"],
            "properties": {
              "alternative": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "swimlane": {"$ref": "#/$defs/swimlane"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "claim", "source", "success", "out_of_scope"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "claim": {"$ref": "#/$defs/claim"},
        "source": {"$ref": "#/$defs/source"},
        "success": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "system_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "components", "external_dependencies", "unknowns"],
      "properties": {
        "claim": {"$ref": "#/$defs/claim"},
        "components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "external_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "owner", "rationale"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "status": {"enum": ["accepted", "proposed"]},
          "owner": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "seams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seam"}},
    "steel_thread": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "status": {"enum": ["FIXED", "ACCEPTED", "OPEN"]},
          "summary": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "contentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["between", "resolution", "order"],
        "properties": {
          "between": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^T-"}},
          "resolution": {"type": "string", "minLength": 1},
          "order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^T-"}}
        }
      }
    }
  }
}
