{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamwise.dev/schemas/task-plan-lineage-v1.json",
  "title": "Seamwise TaskPlan lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "engine_version",
    "intent",
    "delivery_plan_sha256",
    "review",
    "task_plan",
    "units"
  ],
  "properties": {
    "contract": {"const": "SeamwiseTaskPlanLineage/v1"},
    "engine_version": {"type": "string", "minLength": 1},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "delivery_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "plan_sha256", "reviewer", "reviewed_at", "fixture"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "fixture": {"type": "boolean"}
      }
    },
    "task_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "path", "digest"],
      "properties": {
        "contract": {"const": "TaskPlan/v1"},
        "path": {"const": "seamwise/task-plan.json"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "intent", "seam", "swimlane", "leg", "source_sha256"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^T-"},
          "intent": {"type": "string", "minLength": 1},
          "seam": {"type": "string", "minLength": 1},
          "swimlane": {"type": "string", "minLength": 1},
          "leg": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
