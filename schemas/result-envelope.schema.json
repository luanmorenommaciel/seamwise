{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamwise.dev/schemas/result-envelope-v1.json",
  "title": "Seamwise result envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "engine_version", "schema_version", "command", "ok", "token", "exit_code", "workspace", "artifacts", "diagnostics", "next"],
  "properties": {
    "contract": {"const": "SeamwiseCLIResult/v1"},
    "engine_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "command": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "token": {"type": "string", "pattern": "^[A-Z_]+=[A-Z_]+$"},
    "exit_code": {"enum": [0, 2, 3, 4, 5, 10]},
    "workspace": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "artifact": {"type": "string"},
          "detail": {"type": "object"}
        }
      }
    },
    "next": {"type": "array", "items": {"type": "string"}},
    "data": {"type": "object"}
  }
}
